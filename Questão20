aluno = []

while True:
  nome = str(input("Insira o nome do aluno que você deseja cadastrar: ")).strip()
  if nome :
    break
print("Insira o nome do aluno cara!!")

while True:
    try:
        idade = int(input("Informe a idade do aluno: "))
        if 0 < idade < 120:
            break 
        print("Por favor, informe uma idade válida.")
    except ValueError:
        print("Preencha as informações corretamente.")

while True:
    try: 
        nota1 = float(input("Insira a primeira nota: "))
        nota2 = float(input("Insira a segunda nota: "))
        nota3 = float(input("Insira a terceira nota: "))
        
        if 0 <= nota1 <= 10 and 0 <= nota2 <= 10 and 0 <= nota3 <= 10:
            break
        else:
            print("As notas devem ser valores entre 0 e 10.")
    except ValueError:
        print("Preencha as informações corretamente.")


media = (nota1 + nota2 + nota3) / 3


if media >= 7:
    situacao = "Aprovado!!"
else:
    situacao = "Reprovado."

aluno.extend([nome, idade, media, situacao])

print(f"\nAluno {nome} cadastrado com sucesso!!")
print(f"Média: {media:.2f} e Situação: {situacao}")
