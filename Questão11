try:
    numero = int(input("Digite o número: "))
    if numero < 1:
        print("Insira números positivos!!!")
    else:
        cont = 0

        for i in range(1, numero + 1):
            if i % 2 == 0:
                cont += 1
    print(f"A quantidade de números pares entre 1 e {numero} é {cont}")

except ValueError:
    print("Preencha as informações com apenas números inteiros e positivos!!")
